{
  "extends": ["next/core-web-vitals"],
  "overrides": [
    {
      // 判定ロジックは .mjs に置いてあるが、next lint の既定の拡張子は
      // js/jsx/ts/tsx なので、これらのファイルは1行も検査されていなかった。
      // 実際、読み取りを1行消しても型・lint・テスト・ビルドが全部緑のまま通る。
      // package.json の lint に --ext で .mjs を足したうえで、ここで
      // 「使われていない宣言」を落とす。
      "files": ["**/*.mjs"],
      "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
      "rules": {
        "no-unused-vars": [
          "error",
          { "args": "after-used", "argsIgnorePattern": "^_" }
        ]
      }
    }
  ]
}
